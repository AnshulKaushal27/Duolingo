# ==============================================================================
# Duolingo Clone - Backend Environment Variables (.env.example)
# ==============================================================================

# Environment: 'development' or 'production'
ENVIRONMENT=production

# Server listening port (Render provides $PORT automatically)
PORT=8000

# Database Connection:
# - SQLite (Default for quick local development):
DATABASE_URL=sqlite:///duolingo.db
# - PostgreSQL (For Render PostgreSQL, Supabase, Neon, etc.):
# DATABASE_URL=postgresql://username:password@ep-host.render.com/dbname

# CORS Allowed Origins (Comma-separated list):
# Include your Vercel frontend URL, custom domain, and local dev ports
CORS_ORIGINS=https://duolingo-clone.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Secret key for session security
SECRET_KEY=duo_super_secret_session_signing_key_replace_in_production
