# ==============================================================================
# Duolingo Clone - Frontend Environment Variables (.env.example)
# ==============================================================================

# In Production on Vercel:
# Set this to your deployed Render backend service URL (including /api/v1):
# Example: https://duolingo-clone-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://your-duolingo-backend.onrender.com/api/v1

# In Local Development:
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
